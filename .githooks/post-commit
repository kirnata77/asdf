#!/bin/sh
# =====================
# 커밋 직후 자동 push
# =====================
# git commit이 끝나면 git이 이 파일을 실행해서, 방금 만든 커밋을 원격
# 저장소(origin)의 같은 브랜치에 올린다. 한 번만 아래 명령으로 켜 두면
# 된다(CLAUDE.md "Git 작업 규칙" 참고).
#
#   git config core.hooksPath .githooks
#
# push가 실패해도(네트워크, 인증 등) 커밋 자체는 로컬에 그대로 남는다 -
# 원인을 해결한 뒤 git push로 다시 올리면 된다.

# 리베이스/체리픽 도중에는 커밋마다 이 훅이 불리므로, 작업이 끝난 뒤
# 사람이 직접 push하도록 건너뛴다.
git_dir=$(git rev-parse --git-dir)
if [ -d "$git_dir/rebase-merge" ] || [ -d "$git_dir/rebase-apply" ] || [ -f "$git_dir/CHERRY_PICK_HEAD" ]; then
    exit 0
fi

# 브랜치가 아닌 곳(detached HEAD)에서 만든 커밋은 올릴 브랜치가 없다.
branch=$(git symbolic-ref --short -q HEAD) || exit 0

if ! git remote get-url origin >/dev/null 2>&1; then
    echo "[post-commit] 원격 저장소(origin)가 없어 push를 건너뜁니다."
    exit 0
fi

echo "[post-commit] origin/$branch 에 push합니다..."
if git rev-parse --abbrev-ref --symbolic-full-name "@{u}" >/dev/null 2>&1; then
    git push origin "$branch"
else
    # 처음 올리는 브랜치면 추적 관계(upstream)도 함께 설정한다.
    git push -u origin "$branch"
fi || echo "[post-commit] push에 실패했습니다. 커밋은 로컬에 남아 있으니 git push로 다시 올려 주세요."

exit 0
